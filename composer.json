{
    "name": "saizul/bangla-slug",
    "description": "Converts Bangla titles into readable Latin slugs for WordPress.",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "authors": [
        { "name": "Saizul Amin", "homepage": "https://saizul.com" }
    ],
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "wp-coding-standards/wpcs": "^3.0",
        "dealerdirect/phpcodesniffer-composer-installer": "^1.0"
    },
    "autoload": {
        "psr-4": { "SaizulAmin\\BanglaSlug\\": "src/" }
    },
    "scripts": {
        "test": "phpunit -c phpunit.xml.dist",
        "lint": "phpcs",
        "php-lint": "find . -name '*.php' -not -path './vendor/*' -print0 | xargs -0 -n1 php -l"
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    }
}
